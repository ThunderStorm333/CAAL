# n8n Workflow Configuration
# ==========================
# Copy to config.env and update with your values

# n8n Server
N8N_HOST=192.168.20.154:5678
N8N_API_KEY=your_n8n_api_key_here

# CAAL Agent Webhook Server
# (where the agent runs - for /reload-tools and /announce webhooks)
CAAL_HOST=192.168.20.114:8889

# Workflows Directory
# (path on the SSH server where n8n-workflows folder is located)
WORKFLOWS_DIR=/path/to/caal/n8n-workflows

# SSH Credentials for Claude Code CLI
# (n8n credential ID and name for SSH access to server with Claude CLI)
SSH_CREDENTIAL_ID=your_ssh_credential_id
SSH_CREDENTIAL_NAME=your_ssh_credential_name

# n8n API Credential
# (n8n credential ID for HTTP Header Auth with n8n API key)
N8N_API_CREDENTIAL_ID=your_n8n_api_credential_id

# Optional: Radarr configuration (for radarr_search_movies workflow)
RADARR_HOST=192.168.1.100:7878
