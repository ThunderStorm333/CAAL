# CAAL Voice Framework Configuration (Cloud APIs Version)
# ========================================================
# Copy to .env and update values

# =============================================================================
# Network Configuration
# =============================================================================
# Your Docker server's IP address (for LiveKit WebRTC)
CAAL_HOST_IP=192.168.20.114

# =============================================================================
# LiveKit Configuration
# =============================================================================
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# =============================================================================
# Gemini LLM Configuration (via geminicli2api proxy)
# =============================================================================
# The geminicli2api proxy uses your Google AI Pro subscription via OAuth
# Credentials are mounted from: credentials/gemini-oauth.json

# Password for accessing the proxy (clients use this as API key)
GEMINI_PROXY_PASSWORD=caal-secret

# Model to use (see: https://github.com/gzzhongqi/geminicli2api)
# Options: gemini-3-flash, gemini-3-pro, gemini-2.5-pro, etc.
# Suffixes: -search (grounded), -maxthinking, -nothinking
GEMINI_MODEL=gemini-3-flash

# =============================================================================
# Google Cloud STT Configuration
# =============================================================================
# Credentials are mounted from: credentials/gcp-service-account.json
# Enable Cloud Speech-to-Text API in your GCP project

# STT Model: chirp_2 (recommended), chirp_3, latest_long, latest_short
STT_MODEL=chirp_2

# Languages to recognize (comma-separated)
STT_LANGUAGES=en-US

# =============================================================================
# Google Cloud TTS Configuration  
# =============================================================================
# Credentials are mounted from: credentials/gcp-service-account.json
# Enable Cloud Text-to-Speech API in your GCP project

# TTS Voice: See https://cloud.google.com/text-to-speech/docs/voices
TTS_VOICE=en-US-Chirp3-HD-Callirrhoe

# TTS Model: chirp_3 for HD voices
TTS_MODEL=chirp_3

# =============================================================================
# n8n MCP Configuration
# =============================================================================
# n8n MCP endpoint URL (required for workflow tools)
N8N_MCP_URL=http://192.168.20.154:5678/mcp-server/http

# n8n MCP access token (get from n8n Settings > MCP Access)
N8N_MCP_TOKEN=your_n8n_mcp_token_here

# =============================================================================
# Wake Word Detection (Optional - Picovoice Porcupine)
# =============================================================================
# Get your access key from https://console.picovoice.ai/
# Leave empty to disable wake word feature
PORCUPINE_ACCESS_KEY=

# =============================================================================
# General
# =============================================================================
# IANA timezone ID - see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Los_Angeles
# Display name spoken by CAAL
TIMEZONE_DISPLAY=Pacific Time

# =============================================================================
# Context and Tool Settings
# =============================================================================
# Max conversation turns to keep in sliding window (prevents context overflow)
MAX_TURNS=20

# Number of tool responses to cache for follow-up queries
TOOL_CACHE_SIZE=3

# LLM Temperature (0.0-2.0)
LLM_TEMPERATURE=0.7
